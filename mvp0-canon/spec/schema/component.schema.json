{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "anatomy": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "element": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "role": {
            "type": "string"
          },
          "contentSlot": {
            "type": "object",
            "properties": {
              "required": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "required"
            ],
            "additionalProperties": false
          },
          "slotFill": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "text"
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "children"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "contextRef"
                    },
                    "field": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                    }
                  },
                  "required": [
                    "kind",
                    "field"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "loopItem"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "onChildEvent": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "onChildEventPayload": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "$item",
                  "$index"
                ]
              }
            }
          },
          "onClick": {
            "type": "string",
            "minLength": 1
          },
          "textBinding": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "ariaLabel": {
            "type": "string",
            "minLength": 1
          },
          "repeatOver": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "submitOnEnter": {
            "type": "object",
            "properties": {
              "event": {
                "type": "string",
                "minLength": 1
              },
              "payloadField": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              }
            },
            "required": [
              "event",
              "payloadField"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "states": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "initial": {
            "default": false,
            "type": "boolean"
          },
          "final": {
            "default": false,
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "description",
          "initial",
          "final"
        ],
        "additionalProperties": false
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "guard": {
            "type": "string"
          },
          "delay": {
            "type": "string"
          },
          "action": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "increment",
                  "decrement",
                  "push",
                  "removeAt"
                ]
              },
              "source": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "payloadField"
                  },
                  "field": {
                    "type": "string",
                    "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
                  }
                },
                "required": [
                  "kind",
                  "field"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "field",
              "op"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "from",
          "event",
          "to"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "payload": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "boolean"
              ]
            }
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "string",
              "number",
              "boolean",
              "stringList"
            ]
          },
          "default": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "required": [
          "name",
          "type",
          "default"
        ],
        "additionalProperties": false
      }
    },
    "visual": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
        },
        "additionalProperties": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "backgroundColor",
              "color",
              "borderColor"
            ]
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9.]*$"
          }
        }
      }
    },
    "a11y": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "ariaLive": {
          "type": "string",
          "enum": [
            "off",
            "polite",
            "assertive"
          ]
        },
        "focusBehaviour": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "retain",
              "move-to-root",
              "none"
            ]
          }
        },
        "keyboard": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "role",
        "focusBehaviour",
        "keyboard"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "version",
    "anatomy",
    "states",
    "transitions",
    "events",
    "context",
    "visual",
    "a11y"
  ],
  "additionalProperties": false
}

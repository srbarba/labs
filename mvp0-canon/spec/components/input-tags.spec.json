{
  "name": "inputTags",
  "version": "0.2.0",
  "anatomy": [
    { "name": "root", "element": "div", "role": "group" },
    {
      "name": "tag",
      "component": "tag",
      "repeatOver": "tags",
      "slotFill": {
        "label": { "kind": "loopItem" },
        "deleteTrigger": { "kind": "text", "value": "×" }
      },
      "onChildEvent": { "REMOVE": "REMOVE_TAG" },
      "onChildEventPayload": { "REMOVE": { "index": "$index" } }
    },
    {
      "name": "input",
      "element": "input",
      "ariaLabel": "Add tag",
      "submitOnEnter": { "event": "ADD_TAG", "payloadField": "value" }
    }
  ],
  "states": [
    { "name": "active", "description": "Único estado: siempre lista para añadir o quitar tags", "initial": true }
  ],
  "transitions": [
    {
      "from": "active",
      "event": "ADD_TAG",
      "to": "active",
      "action": { "field": "tags", "op": "push", "source": { "kind": "payloadField", "field": "value" } }
    },
    {
      "from": "active",
      "event": "REMOVE_TAG",
      "to": "active",
      "action": { "field": "tags", "op": "removeAt", "source": { "kind": "payloadField", "field": "index" } }
    }
  ],
  "events": [
    { "name": "ADD_TAG", "payload": { "value": "string" } },
    { "name": "REMOVE_TAG", "payload": { "index": "number" } }
  ],
  "context": [
    { "name": "tags", "type": "stringList", "default": [] }
  ],
  "visual": {
    "active": {
      "root": { "backgroundColor": "color.inputTags.active.bg", "borderColor": "color.inputTags.active.border" },
      "input": { "color": "color.inputTags.active.fg", "backgroundColor": "color.inputTags.active.bg" }
    }
  },
  "a11y": {
    "role": "group",
    "focusBehaviour": {
      "active": "retain"
    },
    "keyboard": {}
  }
}
